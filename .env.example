# ── Copy to `.env.local` for `vercel dev`, and set the same names in
# ── Vercel → Project → Settings → Environment Variables for deploys.
# ── NEVER commit real values or paste them into the browser bundle.

# ---- Supabase  (Project Settings → API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...            # safe to expose; guarded by RLS
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SERVER ONLY. Bypasses RLS.

# ---- Stripe  (Dashboard → Developers → API keys) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen` or the dashboard webhook

# ---- Razorpay  (Dashboard → Settings → API Keys) ----
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...             # SERVER ONLY. Never shipped to the browser.

# ---- Resend  (API keys) ----
RESEND_API_KEY=re_...
EMAIL_FROM=Prabhas Fan Archive <orders@yourdomain.com>

# ---- Commerce / site ----
OWNER_EMAIL=you@example.com         # receives every order notification
SHIPPING_PAISE=7900                 # flat shipping in paise (₹79); free over ₹1,999
SITE_URL=https://your-app.vercel.app
